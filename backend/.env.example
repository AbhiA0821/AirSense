# Air Quality Open Data API Configuration
# Acquire free token from: https://aqicn.org/data-platform/token/
WAQI_API_KEY=your_waqi_api_token_here

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PORT=8000

# Google Gemini API Key (Free Tier supported):
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-3.1-flash-lite

# OpenRouteService API Key (optional fallback included):
# ORS_API_KEY=your_ors_api_key_here

# Qdrant Vector DB Configuration (optional; defaults to local storage in backend/qdrant_data):
# QDRANT_PATH=backend/qdrant_data

